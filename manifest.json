{
  "manifest_version": 3,
  "name": "Cyberdeck // Toolkit",
  "version": "1.3.3",
  "description": "A neon HUD that floats over any page: draw (pen/shapes/arrows/text), sticky notes, calculator, accessibility, QR codes, passwords, color picker, unit/currency conversion, screenshots, a focus timer, clipboard history, text tools, and an emoji picker.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Cyberdeck Toolkit",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-hud": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Toggle the Cyberdeck HUD on the current page"
    }
  },
  "permissions": ["storage", "scripting", "activeTab", "tabs"],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": ["content.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["qr.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
